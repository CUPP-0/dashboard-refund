# Google Sheets ID from the URL
GOOGLE_SHEETS_ID=1DLW9Qcb89n2qqop4F3wTSxVIWU4l9ezgeu3vU3UwGIo

# Service account JSON as one-line JSON string (recommended for Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Or use a local service-account.json file (never commit it)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# Dashboard login password; use a long unique password
DASHBOARD_PASSWORD=change-this-to-a-long-random-password

# Secret used to sign the login cookie (at least 32 random characters)
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional polling cache duration in seconds (default 60)
SHEETS_CACHE_SECONDS=60
